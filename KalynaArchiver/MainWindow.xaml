<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:KalynaArchiver" x:Class="KalynaArchiver.MainWindow" x:Name="RootWindow" Title="Keep Vault" Width="1220" Height="860" MinWidth="980" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#08101D" FontFamily="/Keep Vault;component/Assets/Fonts/#Inter" FontSize="14" AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop" PreviewDragOver="Global_PreviewDragOver" PreviewDrop="Global_PreviewDrop">
    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
          <ResourceDictionary Source="Gui/ReferenceScrollBar.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <local:ReferencePathWatermarkConverter x:Key="ReferencePathWatermarkConverter" />

        <ControlTemplate x:Key="RoundedButton" TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#F3F7FB" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8" /></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Chrome" Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="RoundedTextBox" TargetType="TextBox">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                <Grid>
                    <ScrollViewer x:Name="PART_ContentHost" />
                    <local:ReferenceWatermarkTextBlock x:Name="Watermark" Text="{Binding Path=(local:MainWindow.WatermarkText), RelativeSource={RelativeSource TemplatedParent}}" Margin="{TemplateBinding Padding}" Foreground="#91A3B8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Focusable="False" Visibility="Collapsed" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Text" Value=""><Setter TargetName="Watermark" Property="Visibility" Value="Visible" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#91A3B8" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#5DE4EC" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="RoundedPasswordBox" TargetType="PasswordBox">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                <ScrollViewer x:Name="PART_ContentHost" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#91A3B8" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#5DE4EC" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="PasswordBox">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Background" Value="#0A1423" />
            <Setter Property="Foreground" Value="#F3F7FB" />
            <Setter Property="BorderBrush" Value="#304259" />
            <Setter Property="CaretBrush" Value="#5DE4EC" />
            <Setter Property="Template" Value="{StaticResource RoundedPasswordBox}" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F3F7FB" />
            <Setter Property="Background" Value="#0A1423" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#22354D" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#287C8A" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <ControlTemplate x:Key="DarkComboBox" TargetType="ComboBox">
            <Grid x:Name="Chrome">
                <ToggleButton x:Name="DropDownButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Data="M 0 0 L 4 4 L 8 0" Stroke="#91A3B8" StrokeThickness="1.5" />
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="11,8,30,8" IsHitTestVisible="False" VerticalAlignment="Center" />
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                    <Border Background="#0A1423" BorderBrush="#304259" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                        <ScrollViewer MaxHeight="400">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DropDownButton" Property="BorderBrush" Value="#91A3B8" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DropDownButton" Property="BorderBrush" Value="#5DE4EC" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#E8EEF6" />
            <Setter Property="FontFamily" Value="/Keep Vault;component/Assets/Fonts/#Inter" />
        </Style>
        <Style TargetType="{x:Type TextBlock}" x:Key="TextBlockMuted" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#91A3B8" />
        </Style>
        <Style TargetType="{x:Type TextBlock}" x:Key="TextBlockLabel" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>
        <Style TargetType="{x:Type TextBlock}" x:Key="TextBlockSectionTitle" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#43D8E5" />
            <Setter Property="Foreground" Value="#04121B" />
            <Setter Property="Background" Value="#5DE4EC" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template" Value="{StaticResource RoundedButton}" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#81EEF3" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="{x:Type Button}" x:Key="ButtonSecondary" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#17263A" />
            <Setter Property="BorderBrush" Value="#31445D" />
            <Setter Property="Foreground" Value="#E8EEF6" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#22354D" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="{x:Type Button}" x:Key="ButtonDanger" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#54202A" />
            <Setter Property="BorderBrush" Value="#B8505E" />
            <Setter Property="Foreground" Value="#FFE8EB" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#6B2633" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="{x:Type Button}" x:Key="ButtonKeySheet" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B7F7DE" />
            <Setter Property="BorderBrush" Value="#78D9B4" />
            <Setter Property="Foreground" Value="#092A20" />
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Background" Value="#0A1423" />
            <Setter Property="Foreground" Value="#F3F7FB" />
            <Setter Property="BorderBrush" Value="#304259" />
            <Setter Property="SelectionBrush" Value="#287C8A" />
            <Setter Property="CaretBrush" Value="#5DE4EC" />
            <Setter Property="Template" Value="{StaticResource RoundedTextBox}" />
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Background" Value="#0A1423" />
            <Setter Property="BorderBrush" Value="#304259" />
            <Setter Property="Foreground" Value="#F3F7FB" />
            <Setter Property="Template" Value="{StaticResource DarkComboBox}" />
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="#E8EEF6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid x:Name="Chrome" Background="Transparent">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border x:Name="Box" Width="20" Height="20" VerticalAlignment="Center" Background="#0A1423" BorderBrush="#91A3B8" BorderThickness="1" CornerRadius="3">
                        <Path x:Name="Check" Visibility="Collapsed" Data="M 1 5 L 5 9 L 12 1" Width="13" Height="10" Stroke="#04121B" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ContentPresenter Grid.Column="2" VerticalAlignment="Center" RecognizesAccessKey="True" />
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#F3F7FB" /></Trigger>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible" /><Setter TargetName="Box" Property="Background" Value="#5DE4EC" /><Setter TargetName="Box" Property="BorderBrush" Value="#43D8E5" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#F3F7FB" /><Setter TargetName="Box" Property="BorderThickness" Value="2" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                <StackPanel>
                    <ToggleButton x:Name="HeaderButton" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Content="{TemplateBinding Header}" HorizontalContentAlignment="Stretch">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Chrome" Background="#17263A" BorderBrush="#31445D" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center" />
                                    <Path x:Name="Arrow" Grid.Column="1" Data="M 0 0 L 4 4 L 8 0" Stroke="#E8EEF6" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#22354D" /></Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#5DE4EC" /></Trigger>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Data" Value="M 0 4 L 4 0 L 8 4" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <Border x:Name="ExpandedContent" Visibility="Collapsed" Padding="12" Background="#101B2B" CornerRadius="0,0,8,8"><ContentPresenter /></Border>
                </StackPanel>
                <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandedContent" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Background" Value="#304259" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                <Grid x:Name="PART_Track">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3.5" />
                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3.5" HorizontalAlignment="Left" />
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="{x:Type ListBox}">
            <Setter Property="Background" Value="#07101D" />
            <Setter Property="BorderBrush" Value="#304259" />
            <Setter Property="Foreground" Value="#E8EEF6" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ScrollViewer x:Name="PART_ScrollViewer" Focusable="False" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"><ItemsPresenter /></ScrollViewer>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#5DE4EC" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Foreground" Value="#E8EEF6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter /></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#17263A" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#287C8A" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#E8EEF6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid x:Name="Chrome" Background="Transparent">
                            <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Border x:Name="Indicator" Height="3" Background="Transparent" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="18,0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#17263A" /></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#22354D" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Indicator" Property="Background" Value="#5DE4EC" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type Border}" x:Key="BorderCard">
            <Setter Property="Background" Value="#101B2B" />
            <Setter Property="BorderBrush" Value="#24364C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style TargetType="{x:Type Border}" x:Key="BorderInnerCard">
            <Setter Property="Background" Value="#091321" />
            <Setter Property="BorderBrush" Value="#2B3D54" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
          </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="22,18" Style="{StaticResource BorderCard}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="78" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="HeaderLogoImage" Width="78" Height="78" VerticalAlignment="Center" Grid.Column="0" Source="/Keep Vault;component/Assets/KeepVaultLogo.png" />
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Keep Vault" FontSize="30" FontWeight="Bold" Margin="0,0,0,5" />
                        <TextBlock x:Name="SubtitleText" Text="Secure, recoverable archives for Windows" TextWrapping="Wrap" Margin="0,0,0,5" Style="{StaticResource TextBlockMuted}" />
                        <TextBlock x:Name="VersionText" FontSize="15" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="210" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LanguageLabel" Text="Language" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0" Style="{StaticResource TextBlockMuted}" />
                    <ComboBox x:Name="LanguageBox" Grid.Column="2" SelectedIndex="0" SelectionChanged="LanguageBox_SelectionChanged" Grid.Row="0">
                        <ComboBoxItem Content="Deutsch" Tag="de" />
                        <ComboBoxItem Content="English" Tag="en" />
                    </ComboBox>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="0">
                        <Ellipse x:Name="IntegrityDot" Width="9" Height="9" Fill="#F2BD55" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="IntegrityText" Text="Integrität wird geprüft …" Foreground="#F2BD55" />
                    </StackPanel>
                    <TextBlock x:Name="CaptureText" Grid.Row="4" Grid.ColumnSpan="3" Text="Aufnahmeschutz: bestmöglich" HorizontalAlignment="Right" Grid.Column="0" Style="{StaticResource TextBlockMuted}" />
                </Grid>
            </Grid>
        </Border>
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,14" Background="Transparent">
            <TabItem x:Name="ArchiveTab" Header="Archive">
                <Border x:Name="CreatePanel" Margin="0,10,0,0" Padding="18" Style="{StaticResource BorderCard}" AllowDrop="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.02*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="0.98*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock x:Name="CreateTitleText" Text="Create archive" Margin="0,0,0,4" Style="{StaticResource TextBlockSectionTitle}" />
                                    <TextBlock x:Name="CreateSubtitleText" Text="Select files or folders, choose a new target, and handle both separate key sheets before encryption." TextWrapping="Wrap" Style="{StaticResource TextBlockMuted}" />
                                </StackPanel>
                                <WrapPanel Margin="0,0,0,12">
                                    <Button x:Name="AddFilesButton" Content="Add files" Click="AddFiles_Click" Margin="0,0,8,8" />
                                    <Button x:Name="AddFolderButton" Content="Add folder" Click="AddFolder_Click" Margin="0,0,8,8" />
                                    <Button x:Name="ClearInputsButton" Content="Clear selection" Click="ClearInputs_Click" Margin="0,0,8,8" Style="{StaticResource ButtonSecondary}" />
                                </WrapPanel>
                                <ListBox x:Name="InputList" Height="190" SelectionMode="Multiple" Margin="0,0,0,12" AllowDrop="True" DragOver="InputList_DragOver" Drop="InputList_Drop" />
                                <TextBlock x:Name="InputDropHintText" Text="Drop files or folders anywhere in this panel." Foreground="#5DE4EC" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock x:Name="TargetArchiveLabel" Text="Target archive" Margin="0,0,0,6" Style="{StaticResource TextBlockLabel}" />
                                    <TextBlock x:Name="TargetArchiveDropHintText" Text="Drop a folder to create folder(1).kzpaq beside it, or a file to derive name(1).kzpaq." FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" Style="{StaticResource TextBlockMuted}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ArchivePathBox" Grid.Column="0" AllowDrop="True" DragOver="ArchivePathBox_DragOver" Drop="ArchivePathBox_Drop" local:MainWindow.WatermarkText="{Binding SelectedItem.Tag, ElementName=LanguageBox, Converter={StaticResource ReferencePathWatermarkConverter}, ConverterParameter=target, Mode=OneWay}" AutomationProperties.LabeledBy="{Binding ElementName=TargetArchiveLabel}" AutomationProperties.HelpText="{Binding Path=(local:MainWindow.WatermarkText), RelativeSource={RelativeSource Self}}" ToolTip="{Binding Path=(local:MainWindow.WatermarkText), RelativeSource={RelativeSource Self}}" />
                                        <Button x:Name="BrowseArchiveButton" Grid.Column="2" Content="Browse" Click="ChooseArchive_Click" />
                                    </Grid>
                                </StackPanel>
                                <Border Padding="13" Margin="0,0,0,12" Style="{StaticResource BorderInnerCard}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="9" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="9" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="18" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CompressionLabel" Text="Compression" VerticalAlignment="Center" Grid.Row="0" />
                                        <ComboBox x:Name="CompressionBox" Grid.Column="1" Margin="9,0,0,0" SelectedIndex="1" SelectionChanged="CompressionBox_SelectionChanged" Grid.Row="0">
                                            <ComboBoxItem Content="0" />
                                            <ComboBoxItem Content="1" />
                                            <ComboBoxItem Content="2" />
                                            <ComboBoxItem Content="3" />
                                            <ComboBoxItem Content="4" />
                                            <ComboBoxItem Content="5" />
                                        </ComboBox>
                                        <CheckBox x:Name="EncryptBox" Grid.Column="3" Content="Encrypt archive" IsChecked="True" VerticalAlignment="Center" Grid.Row="0" Checked="EncryptBox_Changed" Unchecked="EncryptBox_Changed" />
                                        <TextBlock x:Name="CipherSuiteLabel" Grid.Row="2" Text="Cipher suite" VerticalAlignment="Center" />
                                        <ComboBox x:Name="CipherSuiteBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="9,0,0,0" SelectedIndex="0" SelectionChanged="CipherSuiteBox_SelectionChanged">
                    </ComboBox>
                                        <TextBlock x:Name="Argon2ProfileText" Grid.Row="4" Grid.ColumnSpan="4" Text="Two sequential KDF paths (1 GiB to just under 2 GiB via PMI16, t=4, p=4) with shared 1024-bit master (Paranoia: 4 Argon2id passes, locked RAM required)" FontSize="12" TextWrapping="Wrap" Style="{StaticResource TextBlockMuted}" />
                                    </Grid>
                                </Border>
                                <CheckBox x:Name="DeleteOriginalsBox" Content="Delete original files after a verified comparison" IsChecked="False" Margin="0,0,0,12" />
                                <TextBlock x:Name="DeleteOriginalsHint" Text="The archive is then extracted again and compared byte-for-byte with the original files. Files are deleted only after a complete match." FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" Style="{StaticResource TextBlockMuted}" />
                                <Button x:Name="CreateArchiveButton" Content="Save archive" HorizontalAlignment="Left" Click="CreateArchive_Click" />
                            </StackPanel>
                            <Border x:Name="CreatePasswordPanel" Grid.Column="2" Padding="15" Style="{StaticResource BorderInnerCard}">
                                <StackPanel>
                                    <TextBlock x:Name="CreatePasswordSetupTitle" Text="Four-part password" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <TextBlock x:Name="CreatePasswordSetupHelpText" Text="Extraction requires the user password, the PIN and both independently generated factors A and B. All four are mandatory." FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" Style="{StaticResource TextBlockMuted}" />
                                    <TextBlock x:Name="CreatePasswordLabel" Text="User password" Margin="0,0,0,10" Style="{StaticResource TextBlockLabel}" />
                                    <PasswordBox x:Name="CreatePasswordBox" MaxLength="256" Margin="0,0,0,10" PasswordChanged="CreatePasswordBox_PasswordChanged" />
                                    <TextBlock x:Name="CreatePasswordConfirmLabel" Text="Repeat user password" Margin="0,0,0,10" Style="{StaticResource TextBlockLabel}" />
                                    <PasswordBox x:Name="CreatePasswordConfirmBox" MaxLength="256" Margin="0,0,0,10" PasswordChanged="CreatePasswordBox_PasswordChanged" />
                                    <TextBlock x:Name="CreatePinLabel" Text="PIN" Margin="0,0,0,10" Style="{StaticResource TextBlockLabel}" />
                                    <PasswordBox x:Name="CreatePinBox" MaxLength="16" Margin="0,0,0,10" PasswordChanged="CreatePasswordBox_PasswordChanged" />
                                    <TextBlock x:Name="CreatePinConfirmLabel" Text="Repeat PIN" Margin="0,0,0,10" Style="{StaticResource TextBlockLabel}" />
                                    <PasswordBox x:Name="CreatePinConfirmBox" MaxLength="16" Margin="0,0,0,10" PasswordChanged="CreatePasswordBox_PasswordChanged" />
                                    <TextBlock x:Name="PinHelpText" Text="6 to 16 digits. The PIN is a credential of its own and is required together with the passphrase and both factors." FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" Style="{StaticResource TextBlockMuted}" />
                                    <TextBlock x:Name="PinPolicyStatusText" Text="PIN noch nicht vollständig." Foreground="#F29AA6" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <TextBlock x:Name="PasswordHelpText" Text="24 to 256 characters, at least 3 character groups, 12 distinct and 12 non-hex characters, no hex run of 8+, and a conservative strength estimate of at least 128." FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" Style="{StaticResource TextBlockMuted}" />
                                    <TextBlock x:Name="PasswordEntropyStatusText" Text="Passwortstärke-Schätzwert: 0 / 128 Bit" Foreground="#F2BD55" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <TextBlock x:Name="PasswordPolicyStatusText" Text="All user-password requirements are met." Foreground="#F29AA6" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />
                                    <Expander x:Name="CredentialPolicyHelp" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                        <Expander.Header>
                                            <TextBlock x:Name="CredentialPolicyHelpTitle" FontSize="13" TextWrapping="Wrap" />
                                        </Expander.Header>
                                        <TextBlock x:Name="CredentialPolicyHelpText" FontSize="13" TextWrapping="Wrap" />
                                    </Expander>
                                    <Border Padding="13" Margin="0,0,0,10" Style="{StaticResource BorderCard}">
                                        <StackPanel>
                                            <TextBlock x:Name="PasswordGeneratorTitle" Text="Two independent 1024-bit factors" FontWeight="SemiBold" Margin="0,0,0,8" />
                                            <TextBlock x:Name="PasswordGeneratorHelpText" Text="Nine separate entropy pools need at least 1024 mouse samples each. Generation atomically creates factors A and B, both salts and all three nonce parts, then consumes all source pools." FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" Style="{StaticResource TextBlockMuted}" />
                                            <ProgressBar x:Name="EntropyProgress" Minimum="0" Height="7" Foreground="#5DE4EC" Margin="0,0,0,8" Maximum="1024" />
                                            <TextBlock x:Name="EntropyStatusText" Text="Entropie wird gesammelt …" Foreground="#5DE4EC" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <Button x:Name="GeneratePasswordButton" Content="Generate" HorizontalAlignment="Left" Click="GeneratePassword_Click" Margin="0,0,0,8" />
                                            <TextBlock x:Name="GeneratedPasswordFirstLabel" Text="Generated factor A" Margin="0,0,0,8" Style="{StaticResource TextBlockLabel}" />
                                            <TextBox x:Name="GeneratedPasswordFirstBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" MinHeight="55" Margin="0,0,0,8" />
                                            <TextBlock x:Name="GeneratedPasswordSecondLabel" Text="Generated factor B" Margin="0,0,0,8" Style="{StaticResource TextBlockLabel}" />
                                            <TextBox x:Name="GeneratedPasswordSecondBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" MinHeight="55" Margin="0,0,0,8" />
                                            <WrapPanel Margin="0,0,0,8">
                                                <Button x:Name="PrintKeySheetButton" Content="Print separately" Click="PrintKeySheet_Click" Margin="0,0,7,7" Style="{StaticResource ButtonKeySheet}" />
                                                <Button x:Name="SaveKeySheetButton" Content="Save test PDF" Click="SaveKeySheet_Click" Margin="0,0,7,7" Style="{StaticResource ButtonSecondary}" />
                                                <Button x:Name="ClearCreateSecretsButton" Content="Clear secrets" Click="ClearCreateSecrets_Click" Margin="0,0,7,7" Style="{StaticResource ButtonSecondary}" />
                                            </WrapPanel>
                                            <TextBlock x:Name="KeySheetStatusText" Text="Separate key sheets were printed or explicitly exported for testing for the current archive and factors." Foreground="#F2BD55" FontSize="12" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock x:Name="HintLabel" Text="Optional hint" Margin="0,0,0,10" Style="{StaticResource TextBlockLabel}" />
                                    <TextBox x:Name="HintBox" MaxLength="180" Margin="0,0,0,10" />
                                    <TextBlock x:Name="HintWarningText" Text="Stored in the public container header. Never enter passwords or secret fragments." Foreground="#F2BD55" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>
            <TabItem x:Name="ExtractTab" Header="Extract">
                <Border x:Name="ExtractPanel" Margin="0,10,0,0" Padding="18" Style="{StaticResource BorderCard}" AllowDrop="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="0.95*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock x:Name="ExtractTitleText" Text="Extract archive" Margin="0,0,0,4" Style="{StaticResource TextBlockSectionTitle}" />
                                    <TextBlock x:Name="ExtractSubtitleText" Text="Select a ZPAQ archive or encrypted Keep Vault container." TextWrapping="Wrap" Style="{StaticResource TextBlockMuted}" />
                                </StackPanel>
                                <Border Padding="12" Margin="0,0,0,12" Style="{StaticResource BorderInnerCard}">
                                    <TextBlock x:Name="RecoveryPolicyText" Text="KPAR2 authenticates encrypted archives with two keyed MACs. For plain archives it only provides error correction. Emergency recovery always writes a new file." Foreground="#F2BD55" FontSize="12" TextWrapping="Wrap" />
                                </Border>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock x:Name="ArchiveFileLabel" Text="Archive file" Margin="0,0,0,6" Style="{StaticResource TextBlockLabel}" />
                                    <TextBlock x:Name="ExtractArchiveDropHintText" Text="Drop a .zpaq or .kzpaq file here." FontSize="12" Margin="0,0,0,6" Style="{StaticResource TextBlockMuted}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ExtractArchiveBox" TextChanged="ExtractArchiveBox_TextChanged" Grid.Column="0" AllowDrop="True" DragOver="ExtractArchiveBox_DragOver" Drop="ExtractArchiveBox_Drop" local:MainWindow.WatermarkText="{Binding SelectedItem.Tag, ElementName=LanguageBox, Converter={StaticResource ReferencePathWatermarkConverter}, ConverterParameter=archive, Mode=OneWay}" AutomationProperties.LabeledBy="{Binding ElementName=ArchiveFileLabel}" AutomationProperties.HelpText="{Binding Path=(local:MainWindow.WatermarkText), RelativeSource={RelativeSource Self}}" ToolTip="{Binding Path=(local:MainWindow.WatermarkText), RelativeSource={RelativeSource Self}}" />
                                        <Button x:Name="BrowseExtractArchiveButton" Grid.Column="2" Content="Browse" Click="ChooseExtractArchive_Click" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,12">
                                    <TextBlock x:Name="OutputFolderLabel" Text="New output folder" Margin="0,0,0,6" Style="{StaticResource TextBlockLabel}" />
                                    <TextBlock x:Name="OutputFolderDropHintText" Text="Choose or drop its parent folder. Keep Vault proposes a new subfolder inside it." TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" Style="{StaticResource TextBlockMuted}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="OutputFolderBox" Grid.Column="0" AllowDrop="True" DragOver="OutputFolderBox_DragOver" Drop="OutputFolderBox_Drop" TextChanged="OutputFolderBox_TextChanged" local:MainWindow.WatermarkText="{Binding SelectedItem.Tag, ElementName=LanguageBox, Converter={StaticResource ReferencePathWatermarkConverter}, ConverterParameter=output, Mode=OneWay}" AutomationProperties.LabeledBy="{Binding ElementName=OutputFolderLabel}" AutomationProperties.HelpText="{Binding Path=(local:MainWindow.WatermarkText), RelativeSource={RelativeSource Self}}" ToolTip="{Binding Path=(local:MainWindow.WatermarkText), RelativeSource={RelativeSource Self}}" />
                                        <Button x:Name="BrowseOutputFolderButton" Grid.Column="2" Content="Browse" Click="ChooseOutputFolder_Click" />
                                    </Grid>
                                </StackPanel>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="ExtractArchiveButton" Content="Extract" Click="ExtractArchive_Click" Margin="0,0,8,8" />
                                    <Button x:Name="ListArchiveButton" Content="Show contents" Click="ListArchive_Click" Margin="0,0,8,8" Style="{StaticResource ButtonSecondary}" />
                                    <Button x:Name="EmergencyRecoveryButton" Content="Emergency recovery" Click="EmergencyRecovery_Click" Margin="0,0,8,8" Style="{StaticResource ButtonDanger}" />
                                    <Button x:Name="ClearExtractSecretsButton" Content="Clear secrets" Click="ClearExtractSecrets_Click" Margin="0,0,8,8" Style="{StaticResource ButtonSecondary}" />
                                </WrapPanel>
                            </StackPanel>
                            <Border Grid.Column="2" Padding="15" Style="{StaticResource BorderInnerCard}">
                                <StackPanel>
                                    <TextBlock x:Name="ExtractPasswordTitle" Text="Four factors for extraction" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                                    <TextBlock x:Name="ExtractPasswordHelpText" Text="Enter the user password, the PIN and both factors from the separately stored key sheets." FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" Style="{StaticResource TextBlockMuted}" />
                                    <TextBlock x:Name="ExtractHintLabel" Text="Public archive hint" Margin="0,0,0,10" Style="{StaticResource TextBlockLabel}" />
                                    <Border Padding="11" Margin="0,0,0,10" Style="{StaticResource BorderCard}">
                                        <TextBlock x:Name="ExtractHintText" Text="Noch kein Containerhinweis geladen." Foreground="#F2BD55" FontSize="12" TextWrapping="Wrap" />
                                    </Border>
                                    <TextBlock x:Name="ExtractPasswordLabel" Text="User password" Margin="0,0,0,10" Style="{StaticResource TextBlockLabel}" />
                                    <PasswordBox x:Name="ExtractPasswordBox" MaxLength="1048576" Margin="0,0,0,10" />
                                    <TextBlock x:Name="ExtractPinLabel" Text="PIN" Margin="0,0,0,10" Style="{StaticResource TextBlockLabel}" />
                                    <PasswordBox x:Name="ExtractPinBox" MaxLength="1048576" Margin="0,0,0,10" />
                                    <TextBlock x:Name="ExtractGeneratedPasswordFirstLabel" Text="Factor A from key sheet" Margin="0,0,0,10" Style="{StaticResource TextBlockLabel}" />
                                    <TextBox x:Name="ExtractGeneratedPasswordFirstBox" MaxLength="320" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="62" Margin="0,0,0,10" />
                                    <TextBlock x:Name="ExtractGeneratedPasswordSecondLabel" Text="Factor B from key sheet" Margin="0,0,0,10" Style="{StaticResource TextBlockLabel}" />
                                    <TextBox x:Name="ExtractGeneratedPasswordSecondBox" MaxLength="320" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" MinHeight="62" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </TabItem>
            <TabItem x:Name="EraseTab" Header="Cryptographic erase">
                <Border x:Name="ErasePanel" Margin="0,10,0,0" Padding="18" Style="{StaticResource BorderCard}" AllowDrop="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="830">
                            <StackPanel Margin="0,0,0,13">
                                <TextBlock x:Name="EraseTitleText" Text="Cryptographic erase" Margin="0,0,0,4" Style="{StaticResource TextBlockSectionTitle}" />
                                <TextBlock x:Name="EraseSubtitleText" Text="Destroy recovery data first, then corrupt and delete the encrypted container." TextWrapping="Wrap" Style="{StaticResource TextBlockMuted}" />
                            </StackPanel>
                            <TextBlock x:Name="EraseFileLabel" Text="Encrypted container" Margin="0,0,0,13" Style="{StaticResource TextBlockLabel}" />
                            <TextBlock x:Name="EraseDropHintText" Text="Drop an encrypted .kzpaq container here." FontSize="12" Margin="0,0,0,13" Style="{StaticResource TextBlockMuted}" />
                            <Grid Margin="0,0,0,13">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox TextChanged="ErasePathBox_TextChanged" x:Name="ErasePathBox" Grid.Column="0" AllowDrop="True" DragOver="ErasePathBox_DragOver" Drop="ErasePathBox_Drop" local:MainWindow.WatermarkText="{Binding SelectedItem.Tag, ElementName=LanguageBox, Converter={StaticResource ReferencePathWatermarkConverter}, ConverterParameter=erase, Mode=OneWay}" AutomationProperties.LabeledBy="{Binding ElementName=EraseFileLabel}" AutomationProperties.HelpText="{Binding Path=(local:MainWindow.WatermarkText), RelativeSource={RelativeSource Self}}" ToolTip="{Binding Path=(local:MainWindow.WatermarkText), RelativeSource={RelativeSource Self}}" />
                                <Button x:Name="BrowseEraseButton" Grid.Column="2" Content="Browse" Click="ChooseEraseFile_Click" />
                            </Grid>
                            <Button x:Name="AnalyzeEraseButton" Content="Analyze" HorizontalAlignment="Left" Click="AnalyzeErase_Click" Margin="0,0,0,13" />
                            <Border Padding="14" Margin="0,0,0,13" Style="{StaticResource BorderInnerCard}">
                                <StackPanel>
                                    <TextBlock x:Name="EraseStatusText" Text="No file analyzed yet." Foreground="#F2BD55" TextWrapping="Wrap" Margin="0,0,0,9" />
                                    <TextBlock x:Name="EraseHardwareNoticeText" Text="Hardware SSD secure erase is whole-drive vendor/firmware functionality, not a per-file app operation." Foreground="#F29AA6" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <CheckBox x:Name="EraseConfirmBox" Content="I understand that per-file hardware secure erase on SSDs cannot be guaranteed and I want to delete this encrypted container." Margin="0,0,0,13" />
                            <Button x:Name="EraseContainerButton" Content="Cryptographically erase container" HorizontalAlignment="Left" Click="EraseContainer_Click" Style="{StaticResource ButtonDanger}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" Background="#050B14" Padding="14" Style="{StaticResource BorderCard}" x:Name="LogPanel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                        <TextBlock x:Name="LogTitleText" Text="Security log" FontWeight="SemiBold" Margin="0,0,8,0" />
                        <TextBlock x:Name="OperationStatusText" Text="Working" FontSize="12" VerticalAlignment="Center" Style="{StaticResource TextBlockMuted}" />
                    </StackPanel>
                    <Button x:Name="ClearLogButton" Grid.Column="2" Content="Clear" Click="ClearLog_Click" Style="{StaticResource ButtonSecondary}" />
                </Grid>
                <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,9,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="Transparent" BorderThickness="0" />
            </Grid>
        </Border>
        <Border x:Name="PrivacyShield" Grid.RowSpan="3" Background="#0A1320" CornerRadius="16" BorderBrush="#304259" BorderThickness="1" Panel.ZIndex="1000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image x:Name="PrivacyShieldLogoImage" Width="108" Height="108" HorizontalAlignment="Center" Margin="0,0,0,10" Source="/Keep Vault;component/Assets/KeepVaultLogo.png" />
                <TextBlock Text="Keep Vault" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock x:Name="PrivacyShieldText" Text="Secret content is concealed while Keep Vault is not the active application." TextWrapping="Wrap" TextAlignment="Center" MaxWidth="480" Style="{StaticResource TextBlockMuted}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
