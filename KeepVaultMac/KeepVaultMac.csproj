<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetPlatformMinVersion>14.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <AssemblyName>Keep Vault</AssemblyName>
    <RootNamespace>KalynaArchiver</RootNamespace>
    <Product>Keep Vault</Product>
    <AssemblyTitle>Keep Vault</AssemblyTitle>
    <Version>5.0.3</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);KEEPVAULT_MACOS</DefineConstants>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestoreLockedMode>true</RestoreLockedMode>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <InvariantGlobalization>false</InvariantGlobalization>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <StripSymbols>true</StripSymbols>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KeepVaultAppleTeamIdentifier</_Parameter1>
      <_Parameter2>2T6K9PGS55</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KalynaExpectedSignerSha256</_Parameter1>
      <_Parameter2>$(KalynaExpectedSignerSha256)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KalynaExpectedSignerSha3_512</_Parameter1>
      <_Parameter2>$(KalynaExpectedSignerSha3_512)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KalynaExpectedSignerSkein1024</_Parameter1>
      <_Parameter2>$(KalynaExpectedSignerSkein1024)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KalynaExpectedMldsa87Sha256</_Parameter1>
      <_Parameter2>$(KalynaExpectedMldsa87Sha256)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KalynaExpectedMldsa87Sha3_512</_Parameter1>
      <_Parameter2>$(KalynaExpectedMldsa87Sha3_512)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>KalynaExpectedMldsa87Skein1024</_Parameter1>
      <_Parameter2>$(KalynaExpectedMldsa87Skein1024)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Packaging/**" />
    <EmbeddedResource Include="../KalynaArchiver/Resources/PasswordModel/**/*" Exclude="../KalynaArchiver/Resources/PasswordModel/**/*.py" LogicalName="KeepVault.PasswordModel.%(Filename)%(Extension)" />
    <Compile Include="../KalynaArchiver/Services/AppSettingsStore.cs" Link="Services/AppSettingsStore.cs" />
