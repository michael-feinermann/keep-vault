    <Compile Include="../KalynaArchiver/Services/IPreparedArchiveSource.cs" Link="Services/IPreparedArchiveSource.cs" />
    <Compile Include="../KalynaArchiver/Services/CryptoUsageBudget.cs" Link="Services/CryptoUsageBudget.cs" />
    <Compile Include="../KalynaArchiver/Services/CpuWorkBudget.cs" Link="Services/CpuWorkBudget.cs" />
