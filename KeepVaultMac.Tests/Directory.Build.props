<Project>
  <PropertyGroup>
    <BaseIntermediateOutputPath Condition="'$(BaseIntermediateOutputPath)' == '' and '$(ArtifactsPath)' == ''">$(MSBuildProjectDirectory)/obj/</BaseIntermediateOutputPath>
    <RuntimeIdentifiers>osx-arm64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <!--
      Locked restore stays on here as well, so this harness cannot silently
      acquire a different package set than the one that was reviewed.

      Relaxing it is a deliberate, visible act reserved for changing this test
      project's own dependencies: run "dotnet restore" from KeepVaultMac.Tests
      with the force-evaluate switch, which rewrites this project's lockfile.

      Normal test and release scripts must not pass that switch: it overrides
      locked mode even when both options are present. They explicitly disable
      ForceEvaluate and verify unchanged lockfile hashes. The shipped app has
      its own reviewed lockfile and independent release-verifier hash pin.
    -->
    <RestoreLockedMode Condition="'$(RestoreLockedMode)' == ''">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
